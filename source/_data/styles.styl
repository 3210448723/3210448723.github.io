// YJM custom design layer.
// Loaded after NexT's own styles through theme.custom_file_path.style.

:root {
  --body-bg-color: #f5f7ff;
  --content-bg-color: #ffffff;
  --card-bg-color: #ffffff;
  --text-color: #4b516a;
  --link-color: #5b61d6;
  --link-hover-color: #454bb8;
  --brand-color: #343750;
  --brand-hover-color: #454bb8;
  --blockquote-color: #626a82;
  --theme-color: #5b61d6;
  color-scheme: light;
  --yjm-accent: #5b61d6;
  --yjm-accent-strong: #454bb8;
  --yjm-accent-soft: rgba(91, 97, 214, .11);
  --yjm-surface: rgba(255, 255, 255, .78);
  --yjm-surface-solid: #ffffff;
  --yjm-surface-muted: rgba(247, 248, 255, .9);
  --yjm-border: rgba(91, 97, 214, .14);
  --yjm-border-strong: rgba(91, 97, 214, .3);
  --yjm-shadow: 0 18px 55px rgba(36, 39, 86, .08), 0 3px 12px rgba(36, 39, 86, .04);
  --yjm-shadow-hover: 0 24px 70px rgba(48, 52, 128, .15), 0 8px 22px rgba(48, 52, 128, .08);
  --yjm-sidebar: rgba(24, 27, 50, .96);
  --yjm-code-border: rgba(91, 97, 214, .2);
}

html[data-theme='dark'] {
  --body-bg-color: #141827;
  --content-bg-color: #1b2034;
  --card-bg-color: #242a42;
  --text-color: #d9ddf2;
  --link-color: #aab0ff;
  --link-hover-color: #c4c8ff;
  --brand-color: #f2f3ff;
  --brand-hover-color: #ffffff;
  --blockquote-color: #b6bdd8;
  --theme-color: #aab0ff;
  color-scheme: dark;
  --yjm-accent: #aab0ff;
  --yjm-accent-strong: #c4c8ff;
  --yjm-accent-soft: rgba(170, 176, 255, .14);
  --yjm-surface: rgba(35, 39, 65, .82);
  --yjm-surface-solid: #242741;
  --yjm-surface-muted: rgba(31, 35, 58, .9);
  --yjm-border: rgba(190, 195, 255, .16);
  --yjm-border-strong: rgba(190, 195, 255, .38);
  --yjm-shadow: 0 18px 55px rgba(0, 0, 0, .22), 0 3px 12px rgba(0, 0, 0, .14);
  --yjm-shadow-hover: 0 24px 70px rgba(0, 0, 0, .32), 0 8px 22px rgba(0, 0, 0, .2);
  --yjm-sidebar: rgba(18, 20, 35, .98);
  --yjm-code-border: rgba(190, 195, 255, .24);
}

html {
  scroll-behavior: smooth;
}

html.theme-preload *,
html.theme-preload *::before,
html.theme-preload *::after {
  transition: none !important;
}

body {
  background:
    radial-gradient(circle at 8% 5%, rgba(91, 97, 214, .1), transparent 28rem),
    radial-gradient(circle at 92% 18%, rgba(114, 199, 255, .1), transparent 25rem),
    var(--body-bg-color);
  color: var(--text-color);
  font-family: Inter, 'PingFang SC', 'Microsoft YaHei', system-ui, -apple-system, sans-serif;
  text-rendering: optimizeLegibility;
}

button,
input,
textarea {
  font-family: inherit;
}

::selection {
  background: var(--yjm-accent);
  color: #fff;
}

a {
  transition: color .2s ease, border-color .2s ease, background-color .2s ease, transform .2s ease;
}

.headband {
  background: linear-gradient(90deg, #5b61d6, #7d87ef 45%, #65c9e8);
  height: 4px;
}

header.header,
.main-inner,
.footer-inner {
  box-sizing: border-box;
  max-width: 1040px;
  width: calc(100% - 48px);
}

header.header {
  backdrop-filter: blur(18px);
  background: var(--yjm-surface);
  border: 1px solid var(--yjm-border);
  border-radius: 22px;
  box-shadow: var(--yjm-shadow);
  margin-top: 24px;
  padding: 14px 20px;
}

.column {
  background: transparent;
}

.site-brand-container {
  padding: 0 12px;
}

.site-meta .brand {
  color: var(--brand-color);
  padding: 3px 0;
}

.site-meta .site-title {
  color: var(--brand-color);
  font-family: Inter, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 1.14rem;
  letter-spacing: .04em;
}

.logo-line {
  background: linear-gradient(90deg, transparent, var(--yjm-accent), transparent);
  height: 1px;
  opacity: .8;
}

.site-nav {
  align-items: center;
  display: flex;
  justify-content: flex-end;
}

.main-menu {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  justify-content: flex-end;
}

.menu .menu-item {
  margin: 0;
}

.menu .menu-item a {
  border: 1px solid transparent;
  border-radius: 12px;
  color: var(--text-color);
  padding: 7px 11px;
  transition: color .2s ease, background-color .2s ease, border-color .2s ease, transform .2s ease;
}

.menu .menu-item a:hover,
.menu .menu-item-active a {
  background: var(--yjm-accent-soft);
  border-color: var(--yjm-border);
  color: var(--yjm-accent-strong);
  transform: translateY(-1px);
}

.menu .menu-item .badge {
  background: var(--yjm-accent);
  border-radius: 999px;
  color: #fff;
  margin-left: 5px;
  padding: 1px 6px;
}

.site-nav-right .toggle,
.site-nav-toggle .toggle {
  border-radius: 12px;
  transition: background-color .2s ease, transform .2s ease;
}

.site-nav-right .toggle:hover,
.site-nav-toggle .toggle:hover {
  background: var(--yjm-accent-soft);
  transform: translateY(-1px);
}

.main-inner {
  padding-bottom: 72px;
  padding-top: 48px;
}

.posts-expand .post-block,
.posts-collapse > .post-block,
.page .post-block {
  backdrop-filter: blur(18px);
  background: var(--yjm-surface);
  border: 1px solid var(--yjm-border);
  border-radius: 24px;
  box-shadow: var(--yjm-shadow);
  padding: clamp(24px, 4vw, 46px);
  transition: box-shadow .25s ease, border-color .25s ease, transform .25s ease;
}

.posts-expand .post-block:first-of-type,
.posts-collapse > .post-block:first-of-type,
.page .post-block:first-of-type {
  padding-top: clamp(24px, 4vw, 46px);
}

.posts-expand.index .post-block:hover,
.page .post-block:hover {
  border-color: var(--yjm-border-strong);
  box-shadow: var(--yjm-shadow-hover);
  transform: translateY(-4px);
}

.posts-expand .post-block:not(:first-of-type) {
  margin-top: 24px;
}

.posts-expand .post-header {
  margin-bottom: 28px;
  text-align: left;
}

.posts-expand .post-title {
  color: var(--text-color);
  font-size: clamp(1.55rem, 3vw, 2.15rem);
  font-weight: 700;
  letter-spacing: -.02em;
  line-height: 1.35;
}

.posts-expand .post-title-link {
  color: var(--text-color);
}

.posts-expand .post-title-link::before {
  background: linear-gradient(90deg, var(--yjm-accent), #65c9e8);
  bottom: -5px;
  height: 3px;
}

.posts-expand .post-meta-container {
  color: var(--grey-dark);
  font-family: inherit;
  font-size: .8rem;
  margin-top: 12px;
}

.post-meta {
  align-items: center;
  gap: 7px;
  justify-content: flex-start;
}

.post-meta-item {
  align-items: center;
  background: var(--yjm-accent-soft);
  border: 1px solid var(--yjm-border);
  border-radius: 999px;
  display: inline-flex;
  line-height: 1.5;
  padding: 4px 9px;
}

:not(.post-meta-break) + .post-meta-item::before {
  content: none;
}

.post-meta-item-icon {
  color: var(--yjm-accent);
}

.posts-expand .post-meta-container time {
  border-bottom: 0;
}

.posts-expand .post-body {
  font-size: 1.03rem;
  letter-spacing: .01em;
  line-height: 1.95;
}

.post-body p {
  margin-bottom: 1.2em;
}

.post-body h1,
.post-body h2,
.post-body h3,
.post-body h4,
.post-body h5,
.post-body h6 {
  color: var(--text-color);
  scroll-margin-top: 24px;
}

.post-body h2 {
  border-bottom: 0;
  margin-top: 2.3em;
  padding-bottom: .45em;
  position: relative;
}

.post-body h2::after {
  background: linear-gradient(90deg, var(--yjm-accent), transparent);
  border-radius: 999px;
  bottom: 0;
  content: '';
  height: 3px;
  left: 0;
  position: absolute;
  width: 4.2rem;
}

.post-body h3 {
  margin-top: 1.8em;
}

.post-body a:not(.btn) {
  border-bottom-color: var(--yjm-border-strong);
  color: var(--yjm-accent-strong);
}

.post-body a:not(.btn):hover {
  border-bottom-color: var(--yjm-accent);
  color: var(--yjm-accent);
}

blockquote {
  background: var(--yjm-accent-soft);
  border-left: 4px solid var(--yjm-accent);
  border-radius: 0 14px 14px 0;
  color: var(--blockquote-color);
  margin: 1.5em 0;
  padding: 14px 18px;
}

.post-body img,
.post-body video,
.post-body iframe {
  border: 1px solid var(--yjm-border);
  border-radius: 16px;
  box-shadow: 0 12px 30px rgba(36, 39, 86, .08);
}

.post-body table {
  border: 1px solid var(--yjm-border);
  border-radius: 14px;
  display: block;
  overflow-x: auto;
}

.post-body th {
  background: var(--yjm-accent-soft);
  color: var(--yjm-accent-strong);
}

.post-body tr:hover {
  background: var(--yjm-accent-soft);
}

.post-button {
  margin-top: 26px;
  text-align: left;
}

.post-button .btn {
  background: var(--yjm-accent);
  border: 1px solid var(--yjm-accent);
  border-radius: 999px;
  color: #fff;
  padding: 8px 16px;
  transition: background-color .2s ease, box-shadow .2s ease, transform .2s ease;
}

.post-button .btn:hover {
  background: var(--yjm-accent-strong);
  border-color: var(--yjm-accent-strong);
  box-shadow: 0 8px 18px rgba(91, 97, 214, .25);
  color: #fff;
  transform: translateY(-2px);
}

.posts-expand .post-tags {
  border-top: 1px solid var(--yjm-border);
  margin-top: 34px;
  padding-top: 18px;
}

.posts-expand .post-tags a {
  background: var(--yjm-accent-soft);
  border: 1px solid var(--yjm-border);
  border-radius: 999px;
  color: var(--yjm-accent-strong);
  margin: 4px 6px 4px 0;
  padding: 4px 10px;
}

.posts-expand .post-tags a:hover {
  background: var(--yjm-accent);
  border-color: var(--yjm-accent);
  color: #fff;
  transform: translateY(-1px);
}

figure.highlight,
pre {
  border: 1px solid var(--yjm-code-border);
  border-radius: 16px;
  box-shadow: 0 16px 34px rgba(24, 27, 60, .14);
}

figure.highlight {
  overflow: hidden;
}

figure.highlight .table-container {
  overflow-x: auto;
}

figure.highlight .gutter pre {
  border-radius: 0;
}

.copy-btn {
  border: 1px solid var(--yjm-code-border);
  border-radius: 9px;
  opacity: .72;
  padding: 4px 8px;
}

.copy-btn:hover {
  background: var(--yjm-accent-soft);
  color: var(--yjm-accent-strong);
  opacity: 1;
}

.post-body :not(pre) > code {
  background: var(--yjm-accent-soft);
  border: 1px solid var(--yjm-border);
  border-radius: 6px;
  color: var(--yjm-accent-strong);
  padding: 2px 6px;
}

.reading-progress-bar {
  background: linear-gradient(90deg, #5b61d6, #7d87ef, #65c9e8) !important;
  box-shadow: 0 0 14px rgba(91, 97, 214, .5);
}

.sidebar {
  background: var(--yjm-sidebar) !important;
  border-right: 1px solid rgba(190, 195, 255, .12);
  box-shadow: 18px 0 50px rgba(12, 14, 30, .2) !important;
}

.sidebar-inner {
  color: rgba(255, 255, 255, .78);
}

.site-author-image {
  border: 3px solid rgba(170, 176, 255, .65);
  box-shadow: 0 0 0 7px rgba(170, 176, 255, .1), 0 12px 28px rgba(0, 0, 0, .25);
  width: 96px;
}

.site-author-name {
  color: #fff;
  font-size: 1.05rem;
  letter-spacing: .05em;
}

.site-description {
  color: rgba(255, 255, 255, .62);
  line-height: 1.7;
}

.sidebar .site-state {
  background: rgba(255, 255, 255, .06);
  border: 1px solid rgba(190, 195, 255, .14);
  border-radius: 16px;
  padding: 12px 4px;
}

.sidebar .site-state-item {
  padding: 0 12px;
}

.sidebar .site-state-item-count {
  color: #fff;
}

.sidebar .site-state-item-name {
  color: rgba(255, 255, 255, .58);
}

.sidebar .links-of-author a {
  background: rgba(255, 255, 255, .06);
  border: 1px solid rgba(190, 195, 255, .14);
  border-radius: 999px;
  color: rgba(255, 255, 255, .78);
  margin: 3px;
  padding: 5px 10px;
}

.sidebar .links-of-author a:hover {
  background: rgba(170, 176, 255, .18);
  border-color: rgba(190, 195, 255, .34);
  color: #fff;
  transform: translateY(-1px);
}

.posts-collapse .post-content {
  margin: 0;
}

.posts-collapse .post-content::before,
.posts-collapse .collection-title::before,
.posts-collapse .post-header::before {
  display: none;
}

.posts-collapse .collection-title {
  border-bottom: 1px solid var(--yjm-border);
  padding-bottom: 18px;
}

.posts-collapse .collection-header {
  color: var(--text-color);
  font-size: 1.05rem;
  margin: 0;
}

.posts-collapse .collection-year {
  color: var(--yjm-accent-strong);
  font-size: 1.55rem;
  margin: 32px 0 10px;
}

.posts-collapse .collection-year-count {
  background: var(--yjm-accent-soft);
  border: 1px solid var(--yjm-border);
  border-radius: 999px;
  color: var(--yjm-accent-strong);
  margin-left: 8px;
  padding: 2px 8px;
}

.posts-collapse .post-header {
  border-bottom: 1px solid var(--yjm-border);
  border-radius: 12px;
  margin: 0;
  padding: 14px 10px;
  transition: background-color .2s ease, transform .2s ease;
}

.posts-collapse .post-header:hover {
  background: var(--yjm-accent-soft);
  transform: translateX(4px);
}

.posts-collapse .post-meta-container {
  color: var(--grey-dark);
}

.posts-collapse .post-title a {
  color: var(--text-color);
}

.posts-collapse .post-title a:hover {
  color: var(--yjm-accent-strong);
}

.category-all-title,
.tag-cloud-title {
  color: var(--grey-dark);
  font-size: .9rem;
  letter-spacing: .06em;
  margin-bottom: 18px;
  text-align: left !important;
}

.category-all .category-list {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
}

.category-all .category-list-item {
  align-items: center;
  background: var(--yjm-surface-muted);
  border: 1px solid var(--yjm-border);
  border-radius: 15px;
  display: flex;
  justify-content: space-between;
  margin: 0;
  padding: 13px 15px;
  transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
}

.category-all .category-list-item:hover {
  border-color: var(--yjm-border-strong);
  box-shadow: var(--yjm-shadow);
  transform: translateY(-2px);
}

.category-all .category-list-link {
  border-bottom: 0;
  color: var(--text-color);
  font-weight: 600;
}

.category-all .category-list-count {
  background: var(--yjm-accent-soft);
  border: 1px solid var(--yjm-border);
  border-radius: 999px;
  color: var(--yjm-accent-strong);
  font-size: .78rem;
  padding: 2px 8px;
}

.tag-cloud-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.tag-cloud a,
.tag-cloud .tag-cloud-tags a {
  background: var(--yjm-accent-soft);
  border: 1px solid var(--yjm-border);
  border-radius: 999px;
  color: var(--yjm-accent-strong);
  font-size: .92rem !important;
  margin: 0;
  padding: 7px 13px;
  transition: background-color .2s ease, border-color .2s ease, transform .2s ease;
}

.tag-cloud a:hover,
.tag-cloud .tag-cloud-tags a:hover {
  background: var(--yjm-accent);
  border-color: var(--yjm-accent);
  color: #fff;
  transform: translateY(-2px);
}

.page .post-body > ul:not(.category-list) {
  display: grid;
  gap: 10px;
  list-style: none;
  margin: 1.5em 0;
  padding: 0;
}

.page .post-body > ul:not(.category-list) li {
  background: var(--yjm-surface-muted);
  border: 1px solid var(--yjm-border);
  border-radius: 13px;
  padding: 10px 14px;
  transition: border-color .2s ease, transform .2s ease;
}

.page .post-body > ul:not(.category-list) li:hover {
  border-color: var(--yjm-border-strong);
  transform: translateX(4px);
}

.page .post-body > ul:not(.category-list) li::before {
  color: var(--yjm-accent);
  content: '↗';
  font-weight: 700;
  margin-right: 8px;
}

.pagination {
  border-top-color: var(--yjm-border);
  margin-top: 34px;
}

.pagination .prev,
.pagination .next,
.pagination .page-number {
  border-radius: 999px;
}

.back-to-top {
  backdrop-filter: blur(12px);
  background: var(--yjm-accent) !important;
  border: 1px solid rgba(255, 255, 255, .2);
  border-radius: 999px;
  box-shadow: 0 10px 25px rgba(91, 97, 214, .25);
  height: 38px;
  line-height: 38px;
  overflow: hidden;
}

.footer {
  color: var(--grey-dark);
}

.footer-inner {
  border-top: 1px solid var(--yjm-border);
  padding-top: 22px;
}

html[data-theme='dark'] {
  body {
    background:
      radial-gradient(circle at 8% 5%, rgba(122, 132, 255, .12), transparent 28rem),
      radial-gradient(circle at 92% 18%, rgba(54, 136, 186, .12), transparent 25rem),
      var(--body-bg-color);
  }

  .post-body img,
  .post-body video,
  .post-body iframe {
    box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
  }
}

@media (max-width: 767px) {
  header.header,
  .main-inner,
  .footer-inner {
    width: calc(100% - 28px);
  }

  header.header {
    border-radius: 18px;
    margin-top: 14px;
    padding: 10px 12px;
  }

  .main-inner {
    padding-left: 0;
    padding-right: 0;
    padding-top: 28px;
  }

  .posts-expand .post-block,
  .posts-collapse > .post-block,
  .page .post-block {
    border-radius: 18px;
    padding: 22px 18px;
  }

  .posts-expand .post-block:not(:first-of-type) {
    margin-top: 16px;
  }

  .posts-expand .post-header {
    margin-bottom: 22px;
  }

  .posts-expand .post-title {
    font-size: 1.48rem;
  }

  .posts-expand .post-body {
    font-size: 1rem;
  }

  .post-meta {
    gap: 5px;
  }

  .post-meta-item {
    padding: 3px 7px;
  }

  .menu .menu-item a {
    padding: 6px 9px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

// --------------------------------------------------
// Interaction enhancements
// --------------------------------------------------

header.header {
  position: relative;
}

.yjm-theme-toggle {
  align-items: center;
  background: var(--yjm-accent-soft);
  border: 1px solid var(--yjm-border);
  border-radius: 999px;
  color: var(--text-color);
  cursor: pointer;
  display: inline-flex;
  flex-shrink: 0;
  font-size: .76rem;
  gap: 6px;
  margin-left: 10px;
  padding: 7px 11px;
  transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .2s ease;

  &:hover,
  &:focus-visible {
    background: var(--yjm-accent);
    border-color: var(--yjm-accent);
    color: #fff;
    outline: none;
    transform: translateY(-1px);
  }

  i {
    font-size: .85rem;
  }
}

html.theme-transition,
html.theme-transition body,
html.theme-transition .header,
html.theme-transition .post-block,
html.theme-transition .footer,
html.theme-transition .sidebar,
html.theme-transition .search-popup,
html.theme-transition .yjm-related-card {
  transition: background-color .35s ease, border-color .35s ease, box-shadow .35s ease, color .35s ease !important;
}

.yjm-reading-meta {
  background: var(--yjm-accent);
  border-color: var(--yjm-accent);
  color: #fff;

  .post-meta-item-icon,
  .post-meta-item-text {
    color: inherit;
  }
}

.yjm-reading-meta[hidden] {
  display: none;
}

.yjm-reading-divider {
  opacity: .65;
  padding: 0 4px;
}

// Make the existing NexT TOC read like a floating, trackable reading rail.
.sidebar .post-toc {
  .nav-item > a {
    border: 0;
    border-radius: 9px;
    display: block;
    padding: 2px 8px;
    transition: background-color .2s ease, color .2s ease, padding-left .2s ease;
  }

  .nav .active-current > a {
    background: rgba(170, 176, 255, .14);
    border-left: 2px solid var(--yjm-accent);
    color: #fff;
    font-weight: 600;
    padding-left: 10px;
  }
}

.yjm-article-enhancements {
  order: 20;
  width: 100%;
}

.yjm-toc-toggle {
  align-items: center;
  background: var(--yjm-surface-solid);
  border: 1px solid var(--yjm-border);
  border-radius: 999px;
  box-shadow: var(--yjm-shadow);
  color: var(--yjm-accent-strong);
  cursor: pointer;
  display: flex;
  gap: 8px;
  left: 22px;
  padding: 9px 14px;
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  transition: background-color .2s ease, box-shadow .2s ease, transform .2s ease;
  z-index: 35;

  &:hover,
  &:focus-visible {
    background: var(--yjm-accent);
    box-shadow: var(--yjm-shadow-hover);
    color: #fff;
    outline: none;
    transform: translateY(-50%) translateX(3px);
  }
}

.yjm-related-posts {
  border-top: 1px solid var(--yjm-border);
  margin-top: 42px;
  padding-top: 28px;
}

.yjm-section-heading {
  margin-bottom: 16px;

  h2 {
    color: var(--text-color);
    font-size: 1.15rem;
    margin: 3px 0 0;
  }

  h2 i {
    color: var(--yjm-accent);
    margin-right: 6px;
  }
}

.yjm-section-kicker {
  color: var(--yjm-accent-strong);
  font-size: .66rem;
  font-weight: 700;
  letter-spacing: .16em;
}

.yjm-related-grid {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.yjm-related-card {
  background: var(--yjm-surface-muted);
  border: 1px solid var(--yjm-border);
  border-radius: 16px;
  color: var(--text-color);
  display: flex;
  flex-direction: column;
  min-height: 132px;
  padding: 16px;
  position: relative;
  transition: background-color .2s ease, border-color .2s ease, box-shadow .2s ease, transform .2s ease;

  &:hover {
    background: var(--yjm-surface-solid);
    border-color: var(--yjm-border-strong);
    box-shadow: var(--yjm-shadow-hover);
    color: var(--text-color);
    transform: translateY(-3px);
  }

  strong {
    font-size: .98rem;
    line-height: 1.55;
    margin: 5px 20px 6px 0;
  }

  > span:not(.yjm-related-date) {
    color: var(--grey-dark);
    font-size: .78rem;
    line-height: 1.6;
  }

  > i {
    bottom: 16px;
    color: var(--yjm-accent);
    font-size: .75rem;
    position: absolute;
    right: 16px;
  }
}

.yjm-related-date {
  color: var(--yjm-accent-strong);
  font-size: .7rem;
  letter-spacing: .04em;
}

.yjm-post-navigation {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 24px;
}

.yjm-post-nav-card {
  background: linear-gradient(135deg, var(--yjm-surface-muted), var(--yjm-surface-solid));
  border: 1px solid var(--yjm-border);
  border-radius: 16px;
  color: var(--text-color);
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-height: 76px;
  padding: 15px 17px;
  transition: background-color .2s ease, border-color .2s ease, box-shadow .2s ease, transform .2s ease;

  &:hover {
    border-color: var(--yjm-accent);
    box-shadow: var(--yjm-shadow);
    color: var(--text-color);
    transform: translateY(-2px);
  }

  strong {
    line-height: 1.5;
  }
}

.yjm-post-nav-label {
  color: var(--yjm-accent-strong);
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .05em;
}

.yjm-post-nav-following {
  text-align: right;
}

.yjm-post-nav-card.is-empty {
  background: transparent;
  border-color: transparent;
}

// Glassmorphism search dialog with a compact mobile bottom-sheet interaction.
.search-pop-overlay {
  backdrop-filter: blur(10px) saturate(125%);
  background: rgba(20, 24, 39, .08) !important;

  .search-popup {
    backdrop-filter: blur(24px) saturate(140%);
    background: var(--yjm-surface) !important;
    border: 1px solid var(--yjm-border-strong);
    border-radius: 24px;
    box-shadow: 0 30px 90px rgba(25, 29, 70, .24);
    height: min(720px, 82vh);
    overflow: hidden;
    transform: translateY(12px) scale(.96);
    transition: opacity .3s ease, transform .3s ease;

    .search-active & {
      transform: translateY(0) scale(1);
    }

    .search-header {
      align-items: center;
      background: rgba(255, 255, 255, .26);
      border-bottom: 1px solid var(--yjm-border);
      border-radius: 0;
      padding: 14px 16px;
    }

    .search-icon {
      color: var(--yjm-accent);
    }

    input.search-input {
      color: var(--text-color);
      font-size: 1rem;
      padding: 4px 8px;

      &::placeholder {
        color: var(--grey-dark);
      }
    }

    .popup-btn-close {
      color: var(--grey-dark);
      padding: 0 3px 0 10px;

      &:hover .fa {
        color: var(--yjm-accent);
      }
    }

    .search-result-container {
      height: calc(100% - 64px);
      padding: 18px 24px 24px;
    }

    .search-stats {
      color: var(--grey-dark);
      font-size: .8rem;
    }

    .search-result-list {
      display: grid;
      gap: 10px;
      margin: 0;

      li {
        background: var(--yjm-surface-muted);
        border: 1px solid var(--yjm-border);
        border-radius: 13px;
        list-style: none;
        padding: 12px 14px;
        transition: border-color .2s ease, transform .2s ease;

        &:hover {
          border-color: var(--yjm-border-strong);
          transform: translateX(3px);
        }
      }
    }

    a.search-result-title {
      color: var(--yjm-accent-strong);
      display: block;
      margin-bottom: 4px;
    }

    p.search-result {
      border-bottom: 0;
      color: var(--grey-dark);
      font-size: .82rem;
      line-height: 1.6;
      margin: 0;
      padding: 0;
    }
  }
}

html[data-theme='dark'] .search-pop-overlay {
  background: rgba(0, 0, 0, .3) !important;

  .search-popup .search-header {
    background: rgba(20, 24, 39, .36);
  }
}

// Code language badge, line-number rhythm and copy feedback.
figure.highlight,
.code-container {
  .code-lang {
    background: rgba(255, 255, 255, .1);
    border: 1px solid rgba(255, 255, 255, .16);
    border-radius: 6px;
    color: var(--highlight-foreground);
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .1em;
    line-height: 1;
    opacity: .85;
    padding: 5px 7px;
    right: 44px;
    top: 7px;
  }

  .gutter pre {
    border-right: 1px solid var(--yjm-code-border);
    font-size: .78rem;
    line-height: 1.6;
    opacity: .78;
  }

  .copy-btn {
    align-items: center;
    background: rgba(255, 255, 255, .08);
    border: 1px solid rgba(255, 255, 255, .16);
    border-radius: 8px;
    display: inline-flex;
    justify-content: center;
    min-height: 26px;
    min-width: 30px;
    opacity: .72;
    right: 9px;
    top: 6px;
    transition: background-color .2s ease, color .2s ease, opacity .2s ease, transform .2s ease;

    &:hover,
    &:focus-visible {
      opacity: 1;
      outline: none;
      transform: translateY(-1px);
    }

    &.is-success {
      animation: yjm-copy-pop .35s ease;
      background: #35cd4b;
      border-color: #35cd4b;
      color: #fff;
    }

    &.is-error {
      background: #d95f6a;
      border-color: #d95f6a;
      color: #fff;
    }
  }
}

@keyframes yjm-copy-pop {
  0% { transform: scale(.85); }
  65% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

.yjm-toast {
  align-items: center;
  background: var(--yjm-sidebar);
  border: 1px solid var(--yjm-border-strong);
  border-radius: 999px;
  bottom: 28px;
  box-shadow: var(--yjm-shadow-hover);
  color: #fff;
  display: flex;
  font-size: .82rem;
  gap: 8px;
  left: 50%;
  opacity: 0;
  padding: 10px 16px;
  pointer-events: none;
  position: fixed;
  transform: translate(-50%, 12px);
  transition: opacity .2s ease, transform .2s ease;
  z-index: 60;

  &.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  &.is-error i {
    color: #ff9da6;
  }
}

html[data-theme='dark'] figure.highlight,
html[data-theme='dark'] .code-container {
  color-scheme: dark;
}

@media (max-width: 767px) {
  .yjm-theme-toggle {
    font-size: 0;
    margin: 0;
    padding: 8px 10px;
    position: absolute;
    right: 50px;
    top: 10px;
  }

  .yjm-theme-toggle i {
    font-size: .9rem;
  }

  .yjm-toc-toggle {
    bottom: 84px;
    left: auto;
    padding: 10px 13px;
    top: auto;
    transform: none;
  }

  .yjm-toc-toggle:hover,
  .yjm-toc-toggle:focus-visible {
    transform: translateY(-2px);
  }

  .yjm-related-grid,
  .yjm-post-navigation {
    grid-template-columns: 1fr;
  }

  .yjm-post-nav-following {
    text-align: left;
  }

  .yjm-post-nav-card.is-empty {
    display: none;
  }

  .search-pop-overlay {
    align-items: flex-end;

    .search-popup {
      border-radius: 22px 22px 0 0;
      height: min(86vh, 680px);
      max-height: 100%;
      transform: translateY(24px);
      width: 100%;

      .search-active & {
        transform: translateY(0);
      }

      .search-result-container {
        padding: 16px 14px 24px;
      }
    }
  }
}
